            language_keys = await ReadKeys("<% config.binary.addressable %>/LanguageKeys.bytes");
<% loop field in language_fields %>
            <% field.private_name %> = await ReadMaps("<% config.binary.addressable %>/Language<% field.class_name %>.bytes");
<% end loop %>
