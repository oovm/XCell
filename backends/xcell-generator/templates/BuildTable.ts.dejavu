// 代码生成, 修改无效! (XCell <% compiler_version %>)

import { <% class_name %>Data } from "./data/<% class_name %>Data";
import <% class_name %>DataJson from "../data/<% class_name %>.json";

<% loop line in class_document %>
/** <% line %> */
<% end loop %>
export class <% table_name %> {
    private _data: Map<<% key_type %>, <% class_name %>Data> = new Map();
    private _array: <% class_name %>Data[] = [];

    constructor() {
        this.load(<% class_name %>DataJson);
    }

    private load(json: Record<string, <% class_name %>Data>): void {
        for (const key of Object.keys(json)) {
            const item = json[key] as <% class_name %>Data;
            this._data.set(item.<% key_name %>, item);
            this._array.push(item);
        }
    }

    get(key: <% key_type %>): <% class_name %>Data | undefined {
        return this._data.get(key);
    }

    has(key: <% key_type %>): boolean {
        return this._data.has(key);
    }

    values(): <% class_name %>Data[] {
        return this._array;
    }

    keys(): <% key_type %>[] {
        return Array.from(this._data.keys());
    }

    get size(): number {
        return this._data.size;
    }
}
