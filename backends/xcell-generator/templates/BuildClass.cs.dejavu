// 代码生成, 修改无效! (XCell <% compiler_version %>)
// ReSharper disable RedundantDefaultMemberInitializer, RedundantUsingDirective
// ReSharper disable ArrangeObjectCreationWhenTypeEvident, ArrangeObjectCreationWhenTypeNotEvident
// ReSharper disable EnumUnderlyingTypeIsInt
// ReSharper disable CheckNamespace

using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization;
using System.Text;
using UnityEngine;

namespace <% namespace %>
{
    [DataContract, Serializable]
    public partial class <% class_name %>
    {
<% loop field in class_fields %>
    <% loop line in field.document %>
        /// <% line %>
    <% end loop %>
        [DataMember]
    <% if field.has_default %>
        public <%field.typing%> <%field.name%> = <%field.default%>;
    <% else %>
        public <%field.typing%> <%field.name%>;
    <% end if %>
<% end loop %>
    }
<% if support_clone %>
    public partial class <% class_name %> : ICloneable
    {
        /// <inheritdoc cref="ICloneable.Clone"/>
        public <% class_name %> Clone()
        {
            return (<% class_name %>) MemberwiseClone();
        }
    }
<% end if %>
}
