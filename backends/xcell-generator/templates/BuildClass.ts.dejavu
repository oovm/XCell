// 代码生成, 修改无效! (XCell <% compiler_version %>)

<% if config.namespace %>
export namespace <% config.namespace %> {
<% end if %>

<%- for line in class_document %>
/** <% line %> */
<%- end for %>
export class <% class_name %> {
<%- for field in class_fields %>
    <%- for line in field.document %>
    /** <% line %> */
    <%- end for %>
    <%- if field.has_default %>
    <% field.name %>: <% field.typing %> = <% field.default %>;
    <%- else %>
    <% field.name %>!: <% field.typing %>;
    <%- end if %>
<%- end for %>
}

<% if config.namespace %>
}
<% end if %>
