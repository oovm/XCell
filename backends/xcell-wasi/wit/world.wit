package xcell:core;

/// XCell 世界
world host {
    export xcell-wasi: interface {
        /// 问候函数，测试 WASI 绑定是否正常工作
        hello: func() -> string;

        /// 处理表格命令
        process-table: func(source: option<string>, output: option<string>) -> result<_, string>;

        /// 验证表格命令
        validate-table: func(source: option<string>) -> result<_, string>;

        /// XCell 实例资源
        resource vm {
            /// 创建新的 XCell 实例
            constructor();

            /// 处理数据
            process-data: func(data: option<string>) -> result<string, string>;
        }
    }
}