/**
 * <% class_name %>接口
 */
export interface <% class_name %> {
    /**
     * <% class_name %>ID
     */
    id: number;
    /**
     * <% class_name %>名称
     */
    name: string;
    /**
     * <% class_name %>描述
     */
    description: string;
}

/**
 * <% class_name %>枚举
 */
export const <% class_name %> = {
{% for item in items %}
    /**
     * <% item.name %><% class_name %>
     */
    <% item.key %>: {
        id: <% item.id %>,
        name: "<% item.name %>",
        description: "<% item.description %>"
    }{% if not loop.last %},{% endif %}
{% endfor %}
} as const as Record<string, <% class_name %>>;