// 代码生成, 修改无效! (XCell <% compiler_version %>)
import data from "../../config/game/<% class_name %>.json" assert { type: "json" };

export class <% class_name %>Item {
    private _data: any;

    constructor(data: any, id: number) {
        this._data = data;
        this.id = id;
    }

    /** 编号【KEY】 */
    id: number = 0;
<% loop field in class_fields %>
<% if field.is_key %><% else %>
    /** <% loop line in field.document %><% line %><% end loop %> */
    get <% field.name %>(): <% field.typing %> {
        return this._data.<% field.name %>;
    }
<% end if %>
<% end loop %>
}


export class <% table_name %> {
    /**
     * 根据 ID 查找数据
     * @param id 编号
     * @returns 数据项，如果不存在则返回 null
     */
    static find(id: number): <% class_name %>Item | null {
        const itemData = (data as any)[id.toString()];
        if (!itemData) return null;
        return new <% class_name %>Item(itemData, id);
    }

    /**
     * 获取所有数据
     * @returns 所有数据项数组
     */
    static all(): <% class_name %>Item[] {
        return Object.keys(data).map(id => {
            const itemData = (data as any)[id];
            let itemId: number = Number(id);
            return new <% class_name %>Item(itemData, itemId);
        });
    }

    /**
     * 根据条件筛选数据
     * @param predicate 筛选条件
     * @returns 符合条件的数据项数组
     */
    static filter(predicate: (item: <% class_name %>Item) => boolean): <% class_name %>Item[] {
        return this.all().filter(predicate);
    }
}
