<% if config.namespace %>
export namespace <% config.namespace %> {
<% end if %>

<% loop line in class_document %>
/** <% line %> */
<% end loop %>
export class <% class_name %> {
<% loop field in class_fields %>
    <% loop line in field.document %>
    /** <% line %> */
    <% end loop %>
    <% if field.has_default %>
    <% field.name %>: <% field.typing %> = <% field.default %>;
    <% else %>
    <% field.name %>!: <% field.typing %>;
    <% end if %>
<% end loop %>
}

<% if config.namespace %>
}
<% end if %>
