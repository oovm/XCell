// 代码生成, 修改无效! (XCell <% compiler_version %>)
// ReSharper disable ArrangeObjectCreationWhenTypeEvident
// ReSharper disable ArrangeObjectCreationWhenTypeNotEvident
// ReSharper disable CheckNamespace

using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization;
using System.Text;
using UnityEngine;

namespace <% config.namespace %>
{
    /// <summary>
    /// 多语言配置表
    /// </summary>
    [DataContract, Serializable]
    public partial class LanguageTable
    {
<% loop field in language_fields %>
        [DataMember]
        private Dictionary<string, string> <% field.private_name %> = new();
<% end loop %>

        /// <summary>
        /// 初始化语言表并从二进制文件加载数据
        /// </summary>
        public LanguageTable()
        {
            BinaryRead("<% binary_path %>");
        }

        /// <summary>
        /// 从二进制文件中读取语言数据
        /// </summary>
        /// <param name="path">二进制文件路径</param>
        public void BinaryRead(string path)
        {
            using var stream = new FileStream(path, FileMode.Open, FileAccess.Read);
            using var reader = new BinaryReader(stream, Encoding.UTF8, false);
            BinaryRead(reader);
        }

        /// <summary>
        /// 以小端序 (LittleEndian) 读取二进制数据
        /// </summary>
        /// <param name="r">二进制读取流</param>
        public void BinaryRead(BinaryReader r)
        {
<% loop field in language_fields %>
            <% field.private_name %>.Clear();
            var <% field.private_name %>Count = r.ReadUInt32();
            for (var i = 0; i < <% field.private_name %>Count; i++)
            {
                var key = r.ReadString();
                var value = r.ReadString();
                <% field.private_name %>[key] = value;
            }
<% end loop %>
        }

        /// <summary>
        /// 以小端序 (LittleEndian) 写入二进制数据
        /// </summary>
        /// <param name="w">二进制写入流</param>
        public void BinaryWrite(BinaryWriter w)
        {
<% loop field in language_fields %>
            w.Write((uint)<% field.private_name %>.Count);
            foreach (var kv in <% field.private_name %>)
            {
                w.Write(kv.Key);
                w.Write(kv.Value);
            }
<% end loop %>
        }
    }
}