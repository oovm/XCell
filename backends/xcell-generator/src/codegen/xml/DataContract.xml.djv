<?xml version="1.0" encoding="utf-8"?>
<<% table_name %> xmlns="http://schemas.datacontract.org/2004/07/<% namespace %>">
    <elements>
<%- loop item in items %>
        <<% class_name %>Element>
    <%- loop field in item.fields %>
        <%- if field.is_vector %>
            <<% field.name %> xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays">
            <%- loop element in field.items %>
                <a:<% element.type %>> <% element.name %></a:<% element.type %>>
            <%- end loop %>
            </<% field.name %>>
        <%- else %>
            <<% field.name %>> <% field.data %></<% field.name %>>
        <%- end if %>
    <%- end loop %>
        </<% class_name %>Element>
<%- end loop %>
    </elements>
</<% table_name %>>