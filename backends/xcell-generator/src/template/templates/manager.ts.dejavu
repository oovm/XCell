// <% class_name %>.ts
// Generated by XCell <% compiler_version %>
// Edit time: <% edit_time %>
// Data version: <% data_version %>

<% loop table in tables %>
import { <% table.typing %> } from './<% table.typing %>';
<% end loop %>

export class <% class_name %> {
    private static instance: <% class_name %>;
    <% loop table in tables %>
    private <% table.private_name %>: <% table.typing %> | null = null;
    <% end loop %>

    private constructor() {}

    public static getInstance(): <% class_name %> {
        if (!<% class_name %>.instance) {
            <% class_name %>.instance = new <% class_name %>();
        }
        return <% class_name %>.instance;
    }

    <% loop table in tables %>
    public <% table.public_name %>(): <% table.typing %> {
        if (!this.<% table.private_name %>) {
            this.<% table.private_name %> = new <% table.typing %>();
        }
        return this.<% table.private_name %>!;
    }
    <% end loop %>

    public async init(): Promise<void> {
        // 初始化所有表格数据
        <% loop table in tables %>
        const <% table.private_name %>Data = await fetch('<% table_data_path %><% table.typing %>.json');
        const <% table.private_name %>Json = await <% table.private_name %>Data.json();
        <% table.typing %>.init(<% table.private_name %>Json);
        <% end loop %>
    }
}

export const <% instance_name %> = <% class_name %>.getInstance();